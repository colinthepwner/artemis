{
  "name": "artemis",
  "productName": "Artemis",
  "version": "0.1.7",
  "description": "A visual modding environment for Better Than Adventure!",
  "author": "Colin",
  "private": true,
  "main": "./out/main/index.js",
  "type": "commonjs",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.scripts.json",
    "audit": "node scripts/audit-all.mjs",
    "icon": "node scripts/make-icon.mjs",
    "package:win": "npm run icon && electron-vite build && electron-builder --win",
    "package:mac": "npm run icon && electron-vite build && electron-builder --mac",
    "package:linux": "npm run icon && electron-vite build && electron-builder --linux",
    "dev:clean": "node scripts/dev.mjs --clean"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-java": "^6.0.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.9",
    "@fontsource-variable/inter": "^5.1.0",
    "@fontsource-variable/jetbrains-mono": "^5.1.1",
    "@fontsource/silkscreen": "^5.3.0",
    "@lezer/highlight": "^1.2.3",
    "@radix-ui/react-checkbox": "^1.1.2",
    "@radix-ui/react-context-menu": "^2.3.7",
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-dropdown-menu": "^2.1.2",
    "@radix-ui/react-select": "^2.1.2",
    "@radix-ui/react-slider": "^1.2.1",
    "@radix-ui/react-switch": "^1.1.1",
    "@radix-ui/react-tabs": "^1.1.1",
    "@radix-ui/react-tooltip": "^1.1.3",
    "clsx": "^2.1.1",
    "codemirror": "^6.0.2",
    "framer-motion": "^11.11.9",
    "lucide-react": "^0.454.0",
    "tailwind-merge": "^2.5.4",
    "zustand": "^5.0.1"
  },
  "build": {
    "appId": "com.colin.artemis",
    "productName": "Artemis",
    "directories": {
      "output": "release",
      "buildResources": "resources"
    },
    "files": [
      "out/**/*",
      "resources/**/*",
      "package.json"
    ],
    "fileAssociations": [
      {
        "ext": "artemis",
        "name": "Artemis Mod Project",
        "description": "An Artemis mod project",
        "icon": "resources/file-icon",
        "role": "Editor",
        "mimeType": "application/x-artemis-project"
      }
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "resources/icon.ico",
      "executableName": "Artemis"
    },
    "portable": {
      "artifactName": "Artemis.${ext}",
      "requestExecutionLevel": "user"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Artemis-${version}-setup.${ext}",
      "shortcutName": "Artemis"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ],
      "icon": "resources/icon.icns",
      "category": "public.app-category.developer-tools",
      "darkModeSupport": true,
      "hardenedRuntime": true,
      "entitlements": "resources/entitlements.mac.plist",
      "entitlementsInherit": "resources/entitlements.mac.plist",
      "extendInfo": {
        "NSHighResolutionCapable": true
      }
    },
    "dmg": {
      "artifactName": "Artemis-${version}-${arch}.${ext}"
    },
    "linux": {
      "maintainer": "Colin <10764065+colinthepwner@users.noreply.github.com>",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "resources/icon.png",
      "category": "Development",
      "synopsis": "Visual mod maker for Better Than Adventure!",
      "desktop": {
        "entry": {
          "StartupWMClass": "Artemis",
          "MimeType": "application/x-artemis-project"
        }
      },
      "executableName": "artemis"
    },
    "appImage": {
      "artifactName": "Artemis-${version}-${arch}.${ext}"
    },
    "deb": {
      "artifactName": "Artemis-${version}-${arch}.${ext}",
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libsecret-1-0"
      ]
    }
  },
  "devDependencies": {
    "@types/node": "^22.8.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "jimp": "^1.6.1",
    "postcss": "^8.4.47",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
